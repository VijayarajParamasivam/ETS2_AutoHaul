+        using reader_fn = void (CCore::*)() const;
+
+        // AutoHaul: SEH guard. This function holds no C++ objects that need unwinding, so __try is
+        // allowed here. A reader that hits an access violation (struct offsets that don't match the
+        // running game build) is switched off instead of crashing the game.
+        bool run_guarded(const CCore *self, reader_fn fn, bool force_fault)
+        {
+            __try
+            {
+                if (force_fault)
+                {
+                    // Test hook (AUTOHAUL_TEST_FAULT_READER): proves the guard catches an access violation.
+                    volatile int *bad = nullptr;
+                    (void)*bad;
+                }
+                (self->*fn)();
+                return true;
+            }
+            __except (EXCEPTION_EXECUTE_HANDLER)
+            {
+                return false;
+            }
+        }
+    }
